# Backup do Postgres do financeiro (alicerce). Copie para backup/.env (fora do Git); sem segredos aqui.
AWS_DEFAULT_REGION=us-east-1
AWS_SHARED_CREDENTIALS_FILE=/run/secrets/aws-credentials
RESTIC_REPOSITORY=s3:s3.amazonaws.com/postgres-backup-215073172567-us-east-1-production-alicerce/production-alicerce/postgresql/restic
RESTIC_PASSWORD_FILE=/run/secrets/restic-password
RESTIC_CACHE_DIR=/tmp/restic-cache
DB_HOST=postgres
DB_PORT=5432
DB_NAME=financeiro
DB_USER=backup_readonly
DB_PASSWORD_FILE=/run/secrets/postgres-password
HEALTHCHECK_URL_FILE=/run/secrets/healthcheck-url
BACKUP_ENVIRONMENT=production-alicerce
# Um backup por hora (perda máxima de 1 h); nova tentativa em 15 min se falhar.
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETRY_SECONDS=900
# Retenção: horários 48 h, diários 30 dias, mensais 12 meses, anuais sem prazo (unlimited).
RESTIC_KEEP_HOURLY=48
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=unlimited
