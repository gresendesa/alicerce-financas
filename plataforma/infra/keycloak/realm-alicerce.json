{
  "realm": "alicerce",
  "enabled": true,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "roles": {
    "realm": [
      {
        "name": "fin-owner",
        "description": "Dono dos dados do módulo financeiro"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "fin:read",
      "protocol": "openid-connect",
      "description": "Ler contas, lançamentos e cálculos",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Ler contas, lançamentos e cálculos"
      },
      "protocolMappers": [
        {
          "name": "audiencia-financeiro",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://fin.alicerce.tools/mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "login-do-dono",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "fin:write",
      "protocol": "openid-connect",
      "description": "Registrar, corrigir e conferir lançamentos",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Registrar, corrigir e conferir lançamentos"
      },
      "protocolMappers": [
        {
          "name": "audiencia-financeiro",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://fin.alicerce.tools/mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "fin:profile",
      "protocol": "openid-connect",
      "description": "Declarar intenções, metas e compromissos",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Declarar intenções, metas e compromissos"
      },
      "protocolMappers": [
        {
          "name": "audiencia-financeiro",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://fin.alicerce.tools/mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "fin:structure",
      "protocol": "openid-connect",
      "description": "Criar e alterar contas, cartões e meios de pagamento",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Criar e alterar contas, cartões e meios de pagamento"
      },
      "protocolMappers": [
        {
          "name": "audiencia-financeiro",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://fin.alicerce.tools/mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "fin:share",
      "protocol": "openid-connect",
      "description": "Criar e revogar links públicos de prestação de contas",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Criar e revogar links públicos de prestação de contas"
      },
      "protocolMappers": [
        {
          "name": "audiencia-financeiro",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://fin.alicerce.tools/mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
