# Copie para infra/.env (fora do Git) e troque os valores.
POSTGRES_PASSWORD=troque-esta-senha
# Senha do usuário da aplicação (financeiro_app), sem aspas: openssl rand -hex 32
FINANCEIRO_APP_PASSWORD=troque-esta-senha
# Faixa da rede Docker do Nginx Proxy Manager (docker network inspect nginx-proxy-manager).
PROXIES_CONFIAVEIS=172.29.0.0/16
